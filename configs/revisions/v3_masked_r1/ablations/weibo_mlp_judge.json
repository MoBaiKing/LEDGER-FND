{
  "dataset": {
    "name": "weibo",
    "display_name": "Weibo",
    "adapter": "dataset_tools.weibo.prepare",
    "schema_version": "cute_fnd_multimodal_v1",
    "positive_label": 0,
    "positive_class": "fake",
    "class_names": {
      "0": "fake",
      "1": "real"
    }
  },
  "seed": 200408,
  "data": {
    "root": "datasets/weibo/raw",
    "image_root": "datasets/weibo/raw",
    "processed_dir": "workspaces/weibo/processed",
    "eann_split_dir": "datasets/weibo/raw/eann_split",
    "max_images": 1000,
    "image_size": 224,
    "image_preprocessing": {
      "color_mode": "RGB",
      "transparent_background": "white",
      "train_augmentation": {
        "enabled": true,
        "random_crop_scale": [
          0.9,
          1.0
        ],
        "brightness": 0.08,
        "contrast": 0.08
      }
    },
    "max_text_length": 192,
    "text_instruction": "请提取这条新闻中的事件、人物、时间、地点、因果关系、夸张表达和不确定性线索。新闻：",
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "replay_seed": 200408
  },
  "model": {
    "architecture_version": "qwen_lora_lgled_masked_r1",
    "text_backbone": "pretrained_models/Qwen2.5-7B-Instruct",
    "vision_backbone": "pretrained_models/siglip-base-patch16-224",
    "hidden_dim": 384,
    "num_heads": 8,
    "dropout": 0.2,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_target_modules": [
      "q_proj",
      "v_proj"
    ],
    "qwen_gradient_checkpointing": true,
    "qwen_use_cache": false,
    "qwen_dtype": "bfloat16",
    "qwen_use_lora": true,
    "view_dropout_probability": 0.0,
    "freeze_vision": true,
    "unfreeze_vision_last_n": 2,
    "r1": {
      "latent_judge_num_layers": 2,
      "judge_type": "mlp",
      "visibility": "strict",
      "use_global": true,
      "evidential": true,
      "explicit_relations": true,
      "explicit_vacuity": true,
      "head_hidden_dim": 256,
      "tau": 1.0,
      "fusion": "utility",
      "allow_task_grad_into_routing": false,
      "latent_view_dropout": 0.0,
      "gradient_checkpointing": true
    }
  },
  "train": {
    "epochs": 30,
    "per_gpu_batch_size": 1,
    "grad_accum_steps": 4,
    "vision_learning_rate": 2e-05,
    "lora_learning_rate": 0.0001,
    "head_learning_rate": 4e-05,
    "weight_decay": 0.02,
    "warmup_ratio": 0.1,
    "label_smoothing": 0.0,
    "gradient_clip_norm": 1.0,
    "precision": "bf16",
    "early_stop_patience": 8,
    "monitor": "macro_f1",
    "top_k_checkpoint_average": 5,
    "threshold_min": 0.2,
    "threshold_max": 0.8,
    "threshold_step": 0.01,
    "output_dir": "workspaces/weibo/runs/masked_r1_mlp_judge"
  },
  "loss": {
    "lambda_relation": 0.2,
    "lambda_utility": 1.0,
    "beta_edl": 0.01,
    "edl_warmup_epochs": 3,
    "utility_target": "shapley",
    "epsilon": 1e-07
  },
  "protocol": "r1_replay_pool_v1",
  "reference": {
    "folds": 3,
    "epochs": 3,
    "patience": 2,
    "width": 256,
    "prior_smoothing": 1.0,
    "temperature_grid": [
      0.5,
      1.0,
      2.0,
      4.0
    ],
    "initialization": "pretrained_only",
    "label_smoothing": 0.0,
    "class_weight": null
  },
  "ablation": "mlp_judge"
}
