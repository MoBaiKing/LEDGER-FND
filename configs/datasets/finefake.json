{
  "dataset": {
    "name": "finefake",
    "display_name": "FineFake",
    "adapter": "dataset_tools.finefake.prepare",
    "schema_version": "cute_fnd_multimodal_v1",
    "positive_label": 0,
    "positive_class": "fake",
    "class_names": {
      "0": "fake",
      "1": "real"
    }
  },
  "seed": 200408,
  "data": {
    "root": "datasets/finefake/raw",
    "image_root": "datasets/finefake/raw",
    "processed_dir": "workspaces/finefake/processed",
    "max_images": 1000,
    "image_size": 224,
    "image_preprocessing": {
      "color_mode": "RGB",
      "transparent_background": "white",
      "train_augmentation": {
        "enabled": true,
        "random_crop_scale": [0.85, 1.0],
        "brightness": 0.1,
        "contrast": 0.1,
        "jpeg_recompression": {
          "probability": 0.2,
          "quality": [80, 100]
        }
      }
    },
    "max_text_length": 192,
    "text_instruction": "Extract the event, entities, time, location, causal claims, exaggeration, and uncertainty cues from this news item: ",
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "model": {
    "architecture_version": "qwen_lora_lgled_v3",
    "text_backbone": "pretrained_models/Qwen2.5-7B-Instruct",
    "vision_backbone": "pretrained_models/siglip-base-patch16-224",
    "hidden_dim": 384,
    "num_heads": 8,
    "dropout": 0.3,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_target_modules": ["q_proj", "v_proj"],
    "qwen_gradient_checkpointing": true,
    "qwen_use_cache": false,
    "qwen_dtype": "bfloat16",
    "qwen_use_lora": true,
    "lgled": {
      "enabled": true,
      "projector_type": "shared",
      "judge_type": "qwen_latent",
      "latent_judge_num_layers": 2,
      "use_role_embedding": true,
      "use_evidential_relation": true,
      "use_uncertainty": true,
      "use_critical_minority": true,
      "use_global_judge": true,
      "use_selective_routing": true,
      "routing_threshold": 0.3,
      "routing_scale": 10.0,
      "head_hidden_dim": 256,
      "dropout": 0.1,
      "evidential_reg_weight": 0.0,
      "export_diagnostics": false
    },
    "causal_effect_scale": 0.5,
    "view_dropout_probability": 0.1,
    "freeze_vision": true,
    "unfreeze_vision_last_n": 1
  },
  "train": {
    "epochs": 50,
    "per_gpu_batch_size": 1,
    "grad_accum_steps": 8,
    "vision_learning_rate": 0.000005,
    "lora_learning_rate": 0.00005,
    "head_learning_rate": 0.00003,
    "weight_decay": 0.05,
    "warmup_ratio": 0.08,
    "label_smoothing": 0.08,
    "gradient_clip_norm": 1.0,
    "precision": "bf16",
    "early_stop_patience": 8,
    "monitor": "auc",
    "top_k_checkpoint_average": 3,
    "threshold_min": 0.2,
    "threshold_max": 0.8,
    "threshold_step": 0.01,
    "threshold_plateau_delta": 0.002,
    "output_dir": "workspaces/finefake/runs/training"
  },
  "loss": {
    "classification": 1.0,
    "contrastive": 0.0,
    "causal_probe_classification": 0.0,
    "causal_fidelity": 0.0,
    "event_counterfactual_ranking": 0.0,
    "visual_source_ranking": 0.0,
    "causal_veracity_ranking": 0.0,
    "uncertainty_calibration": 0.0,
    "evidential_regularization": 0.0
  }
}
